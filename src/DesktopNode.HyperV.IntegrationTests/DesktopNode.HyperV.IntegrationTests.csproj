<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Hyper-V adapter integration tier (ADR-0016). This project is deliberately outside src/DesktopNode.sln and the
    Required CI suites: it creates and deletes real pcv-it- prefixed VMs and runs only on explicit request:
    dotnet test src/DesktopNode.HyperV.IntegrationTests -c Release
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DesktopNode.HyperV\DesktopNode.HyperV.csproj" />
  </ItemGroup>

</Project>

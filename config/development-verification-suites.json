{
  "$schema": "./development-verification-suites.schema.json",
  "schema_version": 1,
  "contract": "pcv-development-verification-suite-catalog-v1",
  "activation_state": "active",
  "max_parallelism": 4,
  "overall_timeout_seconds": 1200,
  "allowed_executables": [
    "dotnet",
    "dotnet.exe",
    "node",
    "node.exe",
    "npm",
    "npm.cmd",
    "git",
    "git.exe"
  ],
  "suites": [
    {
      "id": "dotnet",
      "owner": "csharp",
      "migration_state": "cutover",
      "timeout_seconds": 900,
      "executor": {
        "kind": "process",
        "file_name": "dotnet",
        "arguments": [
          "test",
          "src/DesktopNode.sln",
          "-c",
          "Release",
          "--no-build",
          "--no-restore",
          "--nologo"
        ]
      }
    },
    {
      "id": "web-typecheck",
      "owner": "node",
      "migration_state": "cutover",
      "timeout_seconds": 600,
      "executor": {
        "kind": "process",
        "file_name": "npm",
        "arguments": [
          "run",
          "test:required",
          "--prefix",
          "web"
        ]
      }
    },
    {
      "id": "web-parity",
      "owner": "node",
      "migration_state": "cutover",
      "timeout_seconds": 600,
      "executor": {
        "kind": "process",
        "file_name": "npm",
        "arguments": [
          "run",
          "check:verification-migration-manifest",
          "--prefix",
          "web"
        ]
      }
    },
    {
      "id": "delivery-contracts",
      "owner": "csharp",
      "migration_state": "cutover",
      "timeout_seconds": 900,
      "executor": {
        "kind": "process",
        "file_name": "dotnet",
        "arguments": [
          "test",
          "src/DesktopNode.Delivery.Tests/DesktopNode.Delivery.Tests.csproj",
          "-c",
          "Release",
          "--no-build",
          "--no-restore",
          "--filter",
          "Category=Delivery",
          "--nologo"
        ]
      }
    },
    {
      "id": "installer-contracts",
      "owner": "csharp",
      "migration_state": "cutover",
      "timeout_seconds": 900,
      "executor": {
        "kind": "process",
        "file_name": "dotnet",
        "arguments": [
          "test",
          "src/DesktopNode.Delivery.Tests/DesktopNode.Delivery.Tests.csproj",
          "-c",
          "Release",
          "--no-build",
          "--no-restore",
          "--filter",
          "Category=Installer",
          "--nologo"
        ]
      }
    },
    {
      "id": "evidence-check",
      "owner": "csharp",
      "migration_state": "cutover",
      "timeout_seconds": 300,
      "executor": {
        "kind": "managed",
        "managed_handler": "current-evidence-check"
      }
    },
    {
      "id": "policy-boundaries",
      "owner": "csharp",
      "migration_state": "cutover",
      "timeout_seconds": 300,
      "executor": {
        "kind": "managed",
        "managed_handler": "policy-boundaries"
      }
    }
  ],
  "shards": [
    {
      "id": "dotnet",
      "suite_ids": [
        "dotnet"
      ]
    },
    {
      "id": "web",
      "suite_ids": [
        "web-typecheck",
        "web-parity"
      ]
    },
    {
      "id": "delivery",
      "suite_ids": [
        "delivery-contracts",
        "evidence-check"
      ]
    },
    {
      "id": "installer-policy",
      "suite_ids": [
        "installer-contracts",
        "policy-boundaries"
      ]
    }
  ]
}

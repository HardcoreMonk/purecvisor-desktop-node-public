{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://purecvisor.local/schemas/desktop-node-feature-evidence-ledger.schema.json",
  "title": "PureCVisor Desktop Node feature evidence ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract", "features"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract": {
      "const": "pcv-feature-evidence-ledger-v1"
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "feature_id",
          "surfaces",
          "operations",
          "required_stages",
          "candidate_required",
          "current"
        ],
        "properties": {
          "feature_id": {
            "type": "string",
            "pattern": "^pcv\\.[a-z0-9._-]+$"
          },
          "surfaces": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": ["api", "cli", "web"]
            }
          },
          "operations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9.-]+$"
            }
          },
          "required_stages": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "code_tested",
                "packaged",
                "installed_tested",
                "actual_vm_tested",
                "manual_admin_tested"
              ]
            }
          },
          "candidate_required": {
            "type": "boolean"
          },
          "current": {
            "type": "object",
            "additionalProperties": false,
            "required": ["version", "verdict", "evidence"],
            "properties": {
              "version": {
                "type": "string",
                "pattern": "^0\\.[0-9]+\\.[0-9]+-admin-smoke$"
              },
              "verdict": {
                "enum": ["pass", "fail", "blocked", "missing"]
              },
              "evidence": {
                "type": "string",
                "pattern": "^docs/ga-ready/evidence/.+\\.md$"
              }
            }
          }
        }
      }
    }
  }
}
